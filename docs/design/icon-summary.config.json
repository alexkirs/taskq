{
  "version": 1,
  "font": "System",
  "gap": 1,
  "elements": [
    {"id": "work", "type": "counter", "bind": "work", "cell": [0, 0, 0.5, 0.5], "align": "left", "vertical": "top"},
    {"id": "human", "type": "counter", "bind": "ask", "cell": [0.5, 0, 0.5, 0.5], "align": "right", "vertical": "top"},
    {"id": "ready", "type": "counter", "bind": "ready", "cell": [0, 0.5, 0.5, 0.5], "align": "left", "vertical": "bottom"},
    {"id": "history", "type": "histogram", "cell": [0.5, 0.5, 0.5, 0.5], "period": "24h", "series": ["closed", "failed", "ask", "blocked"]}
  ]
}
